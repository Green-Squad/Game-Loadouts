# Set secrets through your shell, a local ignored env file, or Secret Manager.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=loadouts_fixture
DB_USERNAME=loadouts_reader
# DB_PASSWORD: supply securely; do not commit real credentials.
# DATABASE_URL overrides DB_HOST/PORT/DATABASE/USERNAME/PASSWORD.
# DB_SOCKET=/cloudsql/PROJECT:REGION:INSTANCE
# DB_SSL_MODE=verify_identity
# DB_SSL_CA=/path/to/ca.pem
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_ACQUIRE_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=5000
PORT=8080
ASSET_DIR=public
PUBLIC_BASE_URL=https://gameloadouts.com
# If runtime uploads are missing from Git, use a verified media host with /uploads.
# MEDIA_ORIGIN=https://your-media-host.example
DISQUS_ENABLED=0
METRICS_HEADERS=1
RUST_LOG=game_loadouts=info
# Original Google Custom Search URL prefix (contains an API key: treat as a secret).
# SEARCH_API_URL: optional; without it free-text search uses Laravel's Google fallback.
SEARCH_MODE=google
# SEARCH_MODE=local opts into complete DB weapon/game-name matches instead of Google.
